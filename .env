# Site origin (no trailing slash) — canonical URLs, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://ryzonix.pro

# Google Analytics 4 (gtag.js)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-MPR5015LNF

# Search Console — HTML tag method only: paste the TOKEN (not the full DNS TXT line)
# DNS TXT at your registrar would be: google-site-verification=rh9eRCpeHSlyIKKu5ORcsIyPwEtY-wSoI4e-OGAfXY0
NEXT_PUBLIC_GSC_VERIFICATION=rh9eRCpeHSlyIKKu5ORcsIyPwEtY-wSoI4e-OGAfXY0

# Bing Webmaster Tools (meta tag content value)
NEXT_PUBLIC_BING_VERIFICATION=BF89F7F34B71DA869D07A401FAC2717D

# Facebook Pixel (optional)
NEXT_PUBLIC_FB_PIXEL_ID=

# MongoDB & blog API
MONGODB_URI=mongodb://localhost:27017/testing
BLOG_API_SECRET=your-long-random-secret
