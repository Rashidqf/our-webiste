# Site origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.ryzonix.pro

# Google Analytics 4 — measurement ID from GA admin (e.g. G-MPR5015LNF)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Search Console HTML tag: token ONLY (from meta tag method, not the DNS TXT prefix)
# Example token: rh9eRCpeHSlyIKKu5ORcsIyPwEtY-wSoI4e-OGAfXY0
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools — msvalidate.01 content value
NEXT_PUBLIC_BING_VERIFICATION=

# Facebook Pixel (optional)
NEXT_PUBLIC_FB_PIXEL_ID=

MONGODB_URI=mongodb://localhost:27017/testing
BLOG_API_SECRET=your-long-random-secret
