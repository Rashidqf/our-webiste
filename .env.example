# Site origin (no trailing slash) — used for canonical URLs, Open Graph, sitemap
NEXT_PUBLIC_SITE_URL=https://ryzonix.pro

# Google Analytics 4 — replace with your measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=GA_MEASUREMENT_ID

# Google Search Console HTML tag verification content value
NEXT_PUBLIC_GSC_VERIFICATION=your-google-site-verification-token

# Facebook Pixel ID (optional)
NEXT_PUBLIC_FB_PIXEL_ID=

# MongoDB & blog API (existing)
MONGODB_URI=mongodb://localhost:27017/testing
BLOG_API_SECRET=your-long-random-secret