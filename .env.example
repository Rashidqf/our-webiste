# MongoDB connection (Atlas or self-hosted). Required for blog API + SSR pages.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DB_NAME?retryWrites=true&w=majority

# Secret for POST /api/blogs, PATCH/DELETE /api/blogs/[slug], and admin list ?drafts=1 / preview ?preview=1
# Use a long random string in production.
BLOG_API_SECRET=

# Optional: canonical site origin for Open Graph / share links (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.ryzonix.com
